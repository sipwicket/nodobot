TELEGRAM_TOKEN=your-telegram-bot-token-here
ACTIVE_TENANTS=123456789,987654321

# --- Instagram native download (gallery-dl) ---------------------------------
# gallery-dl no longer supports username/password login for Instagram. Auth is
# done exclusively via a cookies.txt exported from a logged-in browser session.
# (Use e.g. "Get cookies.txt LOCALLY" for Chrome or "cookies.txt" for Firefox;
#  ensure sessionid, csrftoken, and ds_user_id are in the file.)
#
# Place the file at the PROJECT ROOT as `cookies.txt`. docker-compose mounts it
# read-only into the container at /app/cookies.txt and exports
# COOKIES_FILE=/app/cookies.txt automatically.
#
# Override only if you keep cookies somewhere else. Relative paths resolve
# against the project root (Deno.cwd() / Docker WORKDIR).
# INSTAGRAM_COOKIES_FILE=/path/to/cookies.txt
# Optional aliases (in order of precedence: INSTAGRAM_COOKIES_FILE >
# GALLERY_DL_COOKIES_FILE > COOKIES_FILE; default: ./cookies.txt):
# GALLERY_DL_COOKIES_FILE=/path/to/cookies.txt
# COOKIES_FILE=/path/to/cookies.txt
# GALLERY_DL_CMD=gallery-dl
