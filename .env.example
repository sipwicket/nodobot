TELEGRAM_TOKEN=your-telegram-bot-token-here
ACTIVE_TENANTS=123456789,987654321

# Native Instagram download uses the Instaloader CLI (Python). Install: pip install instaloader==4.15.1
# Optional: reuse a saved Instaloader session (recommended; anonymous downloads often fail with 403).
# INSTALOADER_LOGIN=your_instagram_username
# INSTALOADER_PASSWORD=your_instagram_password
# INSTALOADER_SESSION_FILE=/path/to/session-file
# INSTALOADER_CMD=instaloader
