# Telegram Bot Token
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Instagram Session Cookies (optional)
# Format: sessionid=xxx; csrftoken=yyy; ds_user_id=zzz
# Get cookies from browser DevTools → Application → Cookies → instagram.com
# Most important: sessionid and csrftoken
INSTAGRAM_COOKIES=sessionid=your_session_id; csrftoken=your_csrf_token; ds_user_id=your_user_id
