TELEGRAM_TOKEN=your-telegram-bot-token-here
ACTIVE_TENANTS=123456789,987654321

# Native Instagram download uses gallery-dl. Install: pip install gallery-dl
# Authenticated downloads: cookies file and/or username + password.
# INSTAGRAM_COOKIES_FILE=/path/to/cookies.txt
# INSTAGRAM_USERNAME=your_instagram_username
# INSTAGRAM_PASSWORD=your_instagram_password
# Optional aliases:
# GALLERY_DL_COOKIES_FILE=/path/to/cookies.txt
# COOKIES_FILE=/path/to/cookies.txt
# GALLERY_DL_USERNAME=your_instagram_username
# GALLERY_DL_PASSWORD=your_instagram_password
# INSTALOADER_LOGIN=your_instagram_username
# GALLERY_DL_CMD=gallery-dl
